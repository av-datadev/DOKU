---
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import ItemCard from '../../components/ItemCard.astro';
import ItemFilm from '../../components/ItemFilm.astro';
import ItemBuy from '../../components/ItemBuy.astro';
import ItemWaitlist from '../../components/ItemWaitlist.astro';
import { fetchProducts, fetchProduct } from '../../lib/products';
import { originFor, regionOf } from '../../lib/origins';
import { CART_COOKIE, decodeCart } from '../../lib/cart';
import { serverEnv } from '../../lib/env';
import { fetchRates, currencyFromCookieValue, CURRENCY_COOKIE } from '../../lib/currency';

// Full object page — SSR per sku, real indexable URL. Pieces whose city has a
// rendered map open with the map film (ItemFilm); the rest keep the two-column
// frame + info layout until their map exists.
const { sku } = Astro.params;
const product = sku ? await fetchProduct(sku) : null;
if (!product) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const p = product;
const isAvailable = p.status === 'available';
const isComingSoon = p.status === 'coming-soon';
const isReserved = p.status === 'reserved';

const cartValue = Astro.cookies.get(CART_COOKIE)?.value;
const held = new Set(await decodeCart(cartValue, serverEnv(Astro.locals, 'CART_SECRET')));
const inCart = held.has(p.sku);

const statusLabel = isAvailable
  ? '1 of 1 — Available'
  : isComingSoon
    ? 'Direction confirmed — object pending'
    : isReserved
      ? 'Held — pending confirmation'
      : 'Claimed — no longer available';

// The place is said once. With a map, the film's corner caption says it; without
// one, this line does. The "Origin" spec row is dropped when it only repeats it.
const origin = originFor(p.sku);
const city = (p.origin ?? '').split(',')[0].trim();
const originLine = isComingSoon ? "We haven't found this one yet." : p.origin;
const specs = Object.entries(p.specs ?? {}).filter(
  ([k, v]) => !(k.toLowerCase() === 'origin' && city && v.includes(city)),
);

const allProducts = await fetchProducts();
const related = allProducts.filter((x) => x.status === 'available' && x.sku !== p.sku).slice(0, 3);

const currency = currencyFromCookieValue(Astro.cookies.get(CURRENCY_COOKIE)?.value);
const rates = await fetchRates();

// Wishlist ("keep an eye on this") is offered on buyable/upcoming items;
// reserved/claimed items instead offer a Web3Forms "notify me if it frees up"
// waitlist. A signed-in shopper's wishlist state for THIS sku is one RLS-scoped
// read (the policy pins it to auth.uid()); guests are prompted to sign in.
const isClaimed = !isAvailable && !isComingSoon && !isReserved;
const canWishlist = isAvailable || isComingSoon;
const canWaitlist = isReserved || isClaimed;
const signedIn = !!Astro.locals.user;
let isWishlisted = false;
if (signedIn && canWishlist) {
  const { data } = await Astro.locals.supabase
    .from('wishlists').select('sku').eq('sku', p.sku).maybeSingle();
  isWishlisted = !!data;
}
const buy = { product: p, currency, rates, inCart, signedIn, isWishlisted };
---

<Base motion="full" title={`${p.title} — DOKU`} description={p.story?.[0] ?? p.teaser ?? undefined}>
  {origin ? (
    <>
      <ItemFilm product={p} origin={origin} statusLabel={statusLabel} faded={!isAvailable && !isComingSoon}>
        <ItemBuy slot="buy" part="action" {...buy} />
      </ItemFilm>

      <section class="item-details wrap" data-details>
        <div class="details-story">
          {p.story && p.story.length > 0 && (
            <div class="story-block">
              <div class="eyebrow">The story</div>
              {p.story.map((para) => <p>{para}</p>)}
            </div>
          )}
          {p.teaser && (
            <div class="story-block">
              <div class="eyebrow">What we're chasing</div>
              <p>{p.teaser}</p>
            </div>
          )}
        </div>
        <div class="details-side">
          <div class="details-notes"><ItemBuy part="notes" {...buy} /></div>
          {specs.length > 0 && (
            <div class="specs">
              {specs.map(([k, v]) => <div class="spec-row"><span>{k}</span><span>{v}</span></div>)}
            </div>
          )}
          {canWaitlist && <ItemWaitlist product={p} />}
        </div>
        <div class="details-craft">
          <div class="details-city">
            <div class="eyebrow">{isComingSoon ? "Where we're looking" : 'The city'}</div>
            <h2 class="serif">{origin.city}, <em>{regionOf(origin)}</em></h2>
            <p>{origin.craft}</p>
          </div>
          <div class="details-where">
            <span class="details-where-label">Where this craft still lives</span>
            <span class="details-where-name serif">{origin.market}</span>
            <span class="details-where-note">{origin.marketNote}</span>
            <p class="details-credit">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a></p>
          </div>
        </div>
      </section>
    </>
  ) : (
    <>
      <div class="breadcrumb"><a href="/collection">The Collection</a> &nbsp;/&nbsp; N° {p.sku}</div>

      <div class="product wrap" data-status={p.status}>
        <Frame id="item-frame" product={p} faded={!isAvailable && !isComingSoon} />

        <div class="product-info">
          <div class="seal-row">
            <div class="seal"><span class="seal-no serif">{p.sku}</span></div>
            <span class:list={['seal-status', { 'is-claimed': !isAvailable }]}>{statusLabel}</span>
          </div>
          <h1 class="serif">{p.title}</h1>
          {originLine && <div class="origin-line">{originLine}</div>}

          <ItemBuy {...buy} />
          {canWaitlist && <ItemWaitlist product={p} />}

          {p.story && p.story.length > 0 && (
            <div class="story-block">
              <div class="eyebrow">The story</div>
              {p.story.map((para) => <p>{para}</p>)}
            </div>
          )}
          {p.teaser && (
            <div class="story-block">
              <div class="eyebrow">What we're chasing</div>
              <p>{p.teaser}</p>
            </div>
          )}
          {specs.length > 0 && (
            <div class="specs">
              {specs.map(([k, v]) => <div class="spec-row"><span>{k}</span><span>{v}</span></div>)}
            </div>
          )}
        </div>
      </div>
    </>
  )}

  {related.length > 0 && (
    <>
      <section class="section-head" data-reveal="line">
        <div class="eyebrow">Also in the collection</div>
        <h2 class="serif">You may not see these again</h2>
      </section>
      <div class="grid wrap" style="padding:0; margin-bottom:100px;">
        {related.map((r) => <ItemCard product={r} held={held.has(r.sku)} currency={currency} rates={rates} />)}
      </div>
    </>
  )}
</Base>

<script>
  import { initItem } from '../../motion/scenes/item';
  initItem();
</script>

<script>
  // Progressive enhancement for "Hold this DOKU": without JS the form POSTs to
  // /api/cart and the server 303-redirects back. With JS we fetch, update the
  // button + header badge in place, and skip the reload.
  function setBadge(count: number) {
    for (const id of ['cart-count-desktop']) {
      const el = document.getElementById(id);
      if (el) {
        el.textContent = String(count);
        el.hidden = count === 0;
      }
    }
  }

  const holdForm = document.getElementById('hold-form') as HTMLFormElement | null;
  holdForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('hold-btn') as HTMLButtonElement | null;
    const label = document.getElementById('hold-btn-label');
    const sub = document.getElementById('hold-sub');
    try {
      const res = await fetch('/api/cart', {
        method: 'POST',
        headers: { accept: 'application/json' },
        body: new FormData(holdForm),
      });
      const data = await res.json();
      if (res.ok) {
        if (btn) btn.disabled = true;
        if (label) label.textContent = 'Held for you';
        if (sub) sub.textContent = 'Review it in your cart to confirm the claim.';
        setBadge(data.count);
      } else if (sub) {
        sub.textContent = data.error ?? 'Could not hold this piece.';
      }
    } catch {
      // Network failure → fall back to a normal submit (server redirect).
      holdForm.submit();
    }
  });

  // "Notify me" for coming-soon items → Web3Forms, same as the live site.
  const notifyForm = document.getElementById('notify-form') as HTMLFormElement | null;
  notifyForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const result = document.getElementById('notify-result');
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(notifyForm),
      });
      const data = await res.json();
      if (result) result.textContent = data.success
        ? "We'll write to you the moment it's found."
        : 'Something went wrong — try again shortly.';
      if (data.success) notifyForm.reset();
    } catch {
      if (result) result.textContent = 'Something went wrong — try again shortly.';
    }
  });

  // Wishlist toggle → /api/account/wishlist. With JS we flip the label + the
  // form's action in place; without JS the server 303-redirects back here.
  const wishlistForm = document.getElementById('wishlist-form') as HTMLFormElement | null;
  wishlistForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const actionInput = wishlistForm.querySelector('input[name="action"]') as HTMLInputElement | null;
    const label = document.getElementById('wishlist-label');
    try {
      const res = await fetch('/api/account/wishlist', {
        method: 'POST',
        headers: { accept: 'application/json' },
        body: new FormData(wishlistForm),
      });
      const data = await res.json();
      if (res.ok) {
        const watching = !!data.watching;
        if (actionInput) actionInput.value = watching ? 'remove' : 'add';
        if (label) label.textContent = watching ? 'Watching — remove' : 'Keep an eye on this';
        wishlistForm.dataset.watching = watching ? '1' : '0';
      } else if (res.status === 401) {
        window.location.href = '/login';
      }
    } catch {
      wishlistForm.submit();
    }
  });

  // Waitlist for reserved/claimed items → Web3Forms, same transport as notify.
  const waitlistForm = document.getElementById('waitlist-form') as HTMLFormElement | null;
  waitlistForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const result = document.getElementById('waitlist-result');
    if (!waitlistForm.checkValidity()) { waitlistForm.reportValidity(); return; }
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(waitlistForm),
      });
      const data = await res.json();
      if (result) result.textContent = data.success
        ? "You're on the list. If it comes back, you'll hear first."
        : 'Something went wrong — try again shortly.';
      if (data.success) waitlistForm.reset();
    } catch {
      if (result) result.textContent = 'Something went wrong — try again shortly.';
    }
  });
</script>

<style>
  .wishlist-row { margin-top: 14px; }
  .btn-wishlist {
    display: inline-block; background: none; border: none; padding: 0; cursor: pointer;
    font: inherit; font-size: .9rem; letter-spacing: .02em; color: var(--claimed);
    text-decoration: underline; text-underline-offset: 3px;
    transition: color .3s cubic-bezier(.16, 1, .3, 1);
  }
  .btn-wishlist:hover { color: var(--gold); }
  .waitlist-block { margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--hairline); }

  /* below the map film: the story, the ledger, then the city and its market */
  .item-details {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px 90px;
    padding: 100px 48px 120px; border-top: 1px solid var(--hairline);
  }
  .details-story .story-block p { margin-top: 0; }
  .details-story .eyebrow { margin-bottom: 18px; }
  .details-side .specs { border-top: none; padding-top: 0; }
  .details-notes:has(> *) { margin-bottom: 30px; padding-bottom: 22px; border-bottom: 1px solid var(--hairline); }
  .details-notes .claim-sub { text-align: left; margin-bottom: 0; }
  .details-notes .wishlist-row { margin-top: 10px; }
  .details-craft {
    grid-column: 1 / -1; display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px 90px;
    margin-top: 50px; padding-top: 60px; border-top: 1px solid var(--hairline); align-items: end;
  }
  .details-city h2 { font-weight: 300; font-size: 34px; line-height: 1.15; margin: 14px 0 20px; }
  .details-city h2 em { color: var(--muted); }
  .details-city p { font-size: 15px; line-height: 1.9; }
  .details-where { display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .details-where-label { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--gold); }
  .details-where-name { font-size: 22px; }
  .details-where-note { font-size: 13px; line-height: 1.7; color: var(--muted); }
  .details-credit { font-size: 11px; color: var(--claimed); margin-top: 14px; }
  .details-credit a { color: var(--claimed); }
  .details-credit a:hover { color: var(--gold); }

  @media (max-width: 900px) {
    .item-details, .details-craft { grid-template-columns: 1fr; padding-left: 24px; padding-right: 24px; }
    .item-details { padding-top: 70px; padding-bottom: 90px; }
    .details-craft { padding-left: 0; padding-right: 0; }
  }
</style>
