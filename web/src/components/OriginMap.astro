---
import { originFor, formatCoords } from '../lib/origins';

// Origin chapter on /item/:sku — a gold street map of the object's city with
// the market looped by hand, and the city's craft beside it. Renders nothing
// for a sku with no entry in origins.json.
interface Props {
  sku: string;
  comingSoon?: boolean;
}
const { sku, comingSoon = false } = Astro.props;
const o = originFor(sku);
// "Oslo, Oslo, Norway" → "Oslo, Norway": drop region parts that repeat the city.
const region = o?.region.split(', ').filter((part) => !part.startsWith(o.city)).join(', ');
---

{o && (
  <section class="origin wrap" data-origin>
    <figure class="origin-map">
      <img src={`/origins/${sku}.svg`} alt={`Street map of ${o.city}, centred on ${o.market}`} loading="lazy" width="600" height="800" />
      <svg class="origin-mark" viewBox="0 0 600 800" aria-hidden="true">
        <!-- a pen loop, left slightly open where it started -->
        <path class="origin-loop" d="M262 392 C 258 356, 330 348, 346 380 C 360 410, 330 446, 292 440 C 258 434, 246 404, 270 384 C 280 377, 292 374, 304 375" />
        <path class="origin-leader" d="M300 352 L 300 262" />
        <text class="origin-market" x="300" y="248">{o.market.toUpperCase()}</text>
      </svg>
      <figcaption class="origin-caption">
        <span class="origin-city serif">{o.city.toUpperCase()}</span>
        <span class="origin-rule"></span>
        <span class="origin-region">{region}</span>
        <span class="origin-coords">{formatCoords(o)}</span>
      </figcaption>
    </figure>

    <div class="origin-text">
      <div class="eyebrow">{comingSoon ? "Where we're looking" : 'Origin'}</div>
      <h2 class="serif">{o.city}, <em>{region}</em></h2>
      <p class="origin-craft">{o.craft}</p>
      <div class="origin-where">
        <span class="origin-where-label">Where this craft still lives</span>
        <span class="origin-where-name serif">{o.market}</span>
        <span class="origin-where-note">{o.marketNote}</span>
      </div>
      <p class="origin-credit">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a></p>
    </div>
  </section>
)}

<style>
  .origin {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 80px; align-items: center;
    padding: 40px 48px 120px; border-top: 1px solid var(--hairline);
  }
  .origin-map {
    position: relative; margin: 0; aspect-ratio: 3 / 4; max-height: 820px;
    background: var(--bg); border: 1px solid var(--hairline); overflow: hidden;
  }
  .origin-map img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .origin-mark { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .origin-loop { fill: none; stroke: var(--gold); stroke-width: 2.4; stroke-linecap: round; }
  .origin-leader { fill: none; stroke: var(--gold); stroke-width: 1; opacity: .8; }
  .origin-market {
    fill: var(--ivory); font: 500 15px 'Archivo', sans-serif; letter-spacing: .2em; text-anchor: middle;
    paint-order: stroke; stroke: var(--bg); stroke-width: 6px; stroke-linejoin: round;
  }
  .origin-caption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 120px 24px 32px;
    display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center;
    background: linear-gradient(to top, var(--bg) 42%, transparent);
  }
  .origin-city { font-size: 30px; font-weight: 400; letter-spacing: .32em; color: var(--gold); padding-left: .32em; }
  .origin-rule { width: 120px; height: 1px; background: var(--gold); }
  .origin-region { font-size: 14px; color: var(--ivory); }
  .origin-coords { font-size: 11px; letter-spacing: .14em; color: var(--muted); font-variant-numeric: tabular-nums; }

  .origin-text h2 { font-weight: 300; font-size: 38px; line-height: 1.15; margin: 14px 0 22px; }
  .origin-text h2 em { color: var(--muted); }
  .origin-craft { font-size: 15px; line-height: 1.9; margin-bottom: 36px; }
  .origin-where { display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .origin-where-label { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--gold); }
  .origin-where-name { font-size: 22px; }
  .origin-where-note { font-size: 13px; line-height: 1.7; color: var(--muted); }
  .origin-credit { font-size: 11px; color: var(--claimed); margin-top: 18px; }
  .origin-credit a { color: var(--claimed); }
  .origin-credit a:hover { color: var(--gold); }

  @media (max-width: 900px) {
    .origin { grid-template-columns: 1fr; gap: 36px; padding: 32px 24px 90px; }
    .origin-text h2 { font-size: 30px; }
    .origin-city { font-size: 24px; }
  }
</style>
